# Path to the SBD library
SBD_PATH=../..

# choose the MPI C++ compiler wrapper (Intel MPI provides 'mpicxx')
  CCCOM=mpicxx

# specify the underlying compiler.
# IMPORTANT: Intel MPI selects the underlying C++ compiler via I_MPI_CXX
#            (NOT MPICH_CXX/OMPI_CXX). Point it at the NVHPC nvc++ 26.3 binary
#            so the H100 OpenMP-offload flags below are understood.
  export I_MPI_CXX=/opt/nvidia/hpc_sdk/Linux_x86_64/26.3/compilers/bin/nvc++
# export MPICH_CXX=g++                                  # (Cray/MPICH only)
# export OMPI_CXX=g++                                   # (OpenMPI only)

#====================================================================================
# ACTIVE BUILD: NVHPC nvc++ 26.3, OpenMP-5 GPU offload to NVIDIA H100 (cc90)
#   - H100 (Hopper) = compute capability 9.0  -> -gpu=cc90
#     (A100 cc80, GB200 cc100, B300 cc103). Requires NVHPC >= 22.7.
#   - -tp=host autodetects the Intel host CPU; replace with an explicit
#     target (e.g. -tp=sapphirerapids) if you prefer to pin it.
#   - -mp=gpu enables OpenMP with GPU offload (also covers host multicore OpenMP).
#====================================================================================
  CCFLAGS  = -O3 -std=c++17 -tp=host -mp=gpu -gpu=cc90 -Minfo=accel \
             -DSBD_TRADMODE -DUSE_GPU -DUSE_OMP_OFFLOAD \
             --diag_suppress declared_but_not_referenced
  LDFLAGS += -mp=gpu -gpu=cc90

