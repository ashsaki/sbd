# flags for linking: link to LAPACK and BLAS from your conda (miniforge) env.
# CONDA_PREFIX is taken from the environment, so activate the env before `make`.
# -Wl,-rpath bakes the path in so the binary finds the .so at runtime without
# needing LD_LIBRARY_PATH. conda ships generic liblapack/libblas (backed by
# openblas); if your env has libopenblas instead, swap to '-lopenblas'.
SYSLIB= -L$(CONDA_PREFIX)/lib -Wl,-rpath,$(CONDA_PREFIX)/lib -llapack -lblas
# SYSLIB= -L$(CONDA_PREFIX)/lib -Wl,-rpath,$(CONDA_PREFIX)/lib -lopenblas

